# ─── Project ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=myapp

# ─── Database ─────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=rootpassword
DB_NAME=appdb
DB_USER=user
DB_PASSWORD=userpw
DB_PORT=3306

# DATABASE_URL is used by Prisma inside the backend container.
# The hostname matches the service name in docker-compose.
DATABASE_URL="mysql://user:userpw@mariadb:3306/appdb"

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=3000

JWT_ACCESS_SECRET=super-secret-key
JWT_REFRESH_SECRET=another-super-secret

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=3001

# Publicly seen URL in the webbrowser
#
# -rbauerMod3- Left EMPTY on purpose. Do not put https://localhost back here.
#
# When empty, api.ts and socket.ts fall back to RELATIVE urls, which follow
# whatever origin served the page: localhost, 127.0.0.1 or the LAN address all
# work with no rebuild, and every call is same-origin so CORS is not involved.
#
# Hard-coding https://localhost made calls from any other origin cross-site, so
# the SameSite=Lax auth cookies were dropped -> permanent 401 -> /login loop.
#
# NEXT_PUBLIC_* values are inlined at BUILD time, so changing them requires
# `make fresh` or `docker compose build frontend`.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=

