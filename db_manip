# rentrer dans le conteneur avec terminal
docker exec -it <container> /bin/sh
docker exec -it ft_transcendence-mandatory-db-1 /bin/sh

# Lancer le client en ligne de commande (en root)
mariadb -u root -p <rootpassword>
mariadb -u root -p rootpass

# Rentrer dans la db
USE <dbname>;
USE appDB;

# Afficher les tables
SHOW TABLES;

# Consulter les colonnes (champs) d'une table
DESCRIBE <table>;
DESCRIBE users;

# Afficher les entrées d'une tables
SELECT * FROM <table>;
SELECT * FROM users;




# Check rapide des colonnes de users
docker exec -it ft_transcendence-mandatory-db-1 mariadb -u root -p'rootpass' appDB -e "DESCRIBE users;"



# Consulter les users
curl http://localhost:3000/users

# Ajoute un user
curl -X POST http://localhost:3000/users \
  -H "Content-Type: application/json" \
  -d '{"username": "user1", "email": "user1@example.com"}'

curl -X POST http://localhost:3000/users -H "Content-Type: application/json" -d '{"username": "user1", "password": "password1", "email": "user1@example.com"}'

# auth
curl -X POST http://localhost:3000/login \
  -H "Content-Type: application/json" \
  -d '{"username": "user1", "email": "user1@example.com"}'

curl -X POST http://localhost:3000/auth/refresh -H "Content-Type: application/json" -d '{"refreshToken": "INSERT_REFRESH_TOKEN"}'

curl -X POST http://localhost:3000/auth/testAccessToken -H "Authorization: Bearer YOUR_ACCESS_TOKEN"