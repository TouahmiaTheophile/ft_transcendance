events pour indiquer collisions (pour anim) et fin de partie:
collision
{
  "type": "event",
  "payload": {
    "event": "collision",
    "player_id": 2,
    "reason": "trail",
    "at": { "x": 5, "y": 8 }
  }
}
joueur éliminé
{
  "type": "event",
  "payload": {
    "event": "player_eliminated",
    "player_id": 2
  }
}
fin de partie
{
  "type": "event",
  "payload": {
    "event": "match_end",
    "winner_id": 1
  }
}



