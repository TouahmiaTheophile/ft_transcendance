====    BASIC TESTS    ====

// users listing
curl http://localhost:3000/users
// Malformed JSON
curl -X POST http://localhost:3000/users -H "Content-Type: application/json" -d '{"username":"test"'


====    DTO VALIDATION    ====

// Missing fields
curl -X POST http://localhost:3000/users -H "Content-Type: application/json" -d '{}'
// Invalid email
curl -X POST http://localhost:3000/users -H "Content-Type: application/json" -d '{"username":"testuser","email":"not-an-email","password":"password123"}'
// Username too short
curl -X POST http://localhost:3000/users -H "Content-Type: application/json" -d '{"username":"ab","email":"test@test.com","password":"password123"}'
// Invalid username characters
curl -X POST http://localhost:3000/users -H "Content-Type: application/json" -d '{"username":"bad@name","email":"test@test.com","password":"password123"}'
// Password too short
curl -X POST http://localhost:3000/users -H "Content-Type: application/json" -d '{"username":"validuser","email":"test@test.com","password":"123"}'
// Unknow fields forbidden
curl -X POST http://localhost:3000/users -H "Content-Type: application/json" -d '{"username":"validuser","email":"test@test.com","password":"password123","admin":true}'


====    USER CREATION / CRUD    ====

// Create user
curl -X POST http://localhost:3000/users -H "Content-Type: application/json" -d '{"username":"john","email":"john@test.com","password":"password123"}'
// Duplicate username
curl -X POST http://localhost:3000/users -H "Content-Type: application/json" -d '{"username":"john","email":"john2@test.com","password":"password123"}'
// Duplicate email
curl -X POST http://localhost:3000/users -H "Content-Type: application/json" -d '{"username":"john2","email":"john@test.com","password":"password123"}'
// Get users
curl http://localhost:3000/users


====    AUTH LOGIN    ====

// Valid login	(store the returned tokens for token tests)
	// old method (body)
curl -X POST http://localhost:3000/auth/login -H "Content-Type: application/json" -d '{"email":"john@test.com","password":"password123"}'
	// current method (cookies)
curl -X POST -H "Content-Type: application/json" -c ./cookies.txt -d '{"email": "john@test.com","password": "password123"}' http://localhost:3000/auth/login

// Wrong password
curl -X POST http://localhost:3000/auth/login -H "Content-Type: application/json" -d '{"email":"john@test.com","password":"wrongpassword"}'
// Unknow user
curl -X POST http://localhost:3000/auth/login -H "Content-Type: application/json" -d '{"email":"unknown@test.com","password":"password123"}'


====    REFRESH TOKEN FLOW    ====

// Valid refresh	(replace REFRESH_TOKEN)
curl -X POST http://localhost:3000/auth/refresh -H "Authorization: Bearer REFRESH_TOKEN"
// Reuse old refresh token
	// Reuse previous command, the token must have been invalidated
// Missing authorization header
curl -X POST http://localhost:3000/auth/refresh
// Invalid authorization format
curl -X POST http://localhost:3000/auth/refresh -H "Authorization: InvalidToken"
// Invalid JWT
curl -X POST http://localhost:3000/auth/refresh -H "Authorization: Bearer invalid.jwt.token"

Try a 2nd refresh, check that the received tokens are differents from the first ones

// Concurrency refresh	(only one received refresh token must be valid) (replace REFRESH_TOKEN)
TOKEN="REFRESH_TOKEN" curl -s -X POST http://localhost:3000/auth/refresh -H "Authorization: Bearer $TOKEN" & curl -s -X POST http://localhost:3000/auth/refresh -H "Authorization: Bearer $TOKEN" & wait

// 	the result of this test might be
curl -X POST http://localhost:3000/auth/refresh -H "Authorization: Bearer REFRESH_TOKEN" & curl -X POST http://localhost:3000/auth/refresh -H "Authorization: Bearer REFRESH_TOKEN"


