export interface APIErrorResponse {
  statusCode: number;		// code d'erreur HTTP
  code: ErrorCode;			// ENUM pour indiquer l'erreur comme on en a besoin (spécifique à notre app pas HTTP)
  message: string;			// message d'erreur (log, debug, ou fallback UX)
  details: ErrorDetails;	// donnée transmise pour permettre de traiter l'erreur/répondre au client
								// ! varie selon le code
  timestamp: string;
  path: string;				// la route qui a reçu la requête ayant déclenché l'erreur
}

// ==== CODES ACTUELS ====
export enum ErrorCode {
  BAD_REQUEST = 'BAD_REQUEST',					// erreur lié à la requête en elle même (ex: syntaxe)
  UNAUTHORIZED = 'UNAUTHORIZED',				// erreur lié à l'identité (auth requise, token invalide)
  FORBIDDEN = 'FORBIDDEN',						// action refusée (ex: manque de permission (role admin requis), accès à la page profil d'un autre user que lui-même)
  NOT_FOUND = 'NOT_FOUND',						// route non trouvé (pourrait camouffler une Forbidden (principe de sécurité: ne pas exposer l'architecture interne))
  CONFLICT = 'CONFLICT',						// requête valide, mais non applicable du à l'état actuel (UNIQUE_CONSTRAINT, double action interdite (ex: acceptation d'invitation/amis, création d'une salle déjà créée...))

  UNIQUE_CONSTRAINT = 'UNIQUE_CONSTRAINT',		// sous catégorie plus précise de CONFLICT, erreur db, valeur déjà utilisé pour champ @Unique (ex: username/email déjà utilisé)
  VALIDATION_ERROR = 'VALIDATION_ERROR',		// donnée entrantes invalides (ex: champs manquants ou invalides, champs non autorisés/attendus)

  INTERNAL_ERROR = 'INTERNAL_ERROR',			// erreur fallback ou technique (ex: erreur non géré spécifiquement, problème techniques (réseau, mémoire))
}

// ==== TYPES POSSIBLES POUR DETAILS ACTUELLEMENT ====
export type ValidationErrorDetails = {
  fields: Record<string, string[]>;
};

export type UniqueConstraintDetails = {
  fields: string[];
};

export type BadRequestDetails = {
  reason?: string;
};

export type UnknownDetails = null;

export type ErrorDetails =
  | ValidationErrorDetails
  | UniqueConstraintDetails
  | BadRequestDetails
  | UnknownDetails;


// ==== EXEMPLE DE GESTION D'ERREUR ====

try {
  await api.register(data);
} catch (error) {
  const err = error.response.data;

  switch (err.code) {
    case 'VALIDATION_ERROR':
      displayFieldErrors(err.details.fields);
      break;

    case 'UNIQUE_CONSTRAINT':
	  buildErrorMessageFromFields(err.details.fields)
      highlightFields(err.details.fields);
      break;

    case 'UNAUTHORIZED':
      redirectToLogin();
      break;

    default:
      showMessage('Unexpected error');
  }
}

