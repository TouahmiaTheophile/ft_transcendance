/*
  DO NOT:
    Change SQL name for columns (eg: fieldName Type @Unique(map: otherName))
      The error handler relies on it to provide precise errors (see prisma-error.utils.ts)

*/

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  passwordHash  String    @db.VarChar(100)
  email         String    @unique @db.VarChar(100)

  age           Int?

  refreshSessions RefreshSession[]

  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("users") // Correspond to "users" table in db
}

model RefreshSession {
  id               String   @id @default(cuid())

  userId           Int
  user             User @relation(fields: [userId], references: [id])

  refreshTokenHash String

  expiresAt        DateTime

  createdAt        DateTime @default(now())

  revokedAt        DateTime?
}